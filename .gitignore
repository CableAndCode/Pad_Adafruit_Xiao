# Git ignore list for PlatformIO + ESP32 + macOS
# Keeps the repo clean from build artifacts and personal settings


.pio/
.pio/libdeps/
/include/

.vscode/
.vscode/*.db
.vscode/*.json
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
# Anything with "private" in the name stays local. A specific filename does not
# protect against a typo, and a typo has already happened once: a file called
# mac_adersses_private.cpp slipped into the history carrying real MAC addresses.
*private*

lib/
test/
**/*.zip

# OS X metadata
.DS_Store

# Arduino build and temporary files
*.bin
*.elf
*.hex

# Core dumps / logs / backups
*.log
*.bak
*.tmp

# TFT_eSPI specific configs (legacy — config now lives in platformio.ini)
User_Setup.h

# Always track README
!README.md
